{"schema_version": 1, "status": "success", "synthetic": false, "config_sha256": "8e384a54d34b5e429bde43443d5f620830e9927c6a92802d4a2b01a599aba7e4", "parser_sha256": "a6514eb82578bbcac85ab788528c07c17c2eaa26c556bee7cf77e4fe825c61bc", "enrichment": {"schema_version": 1, "parser_version": "crossref-1.0.0", "synthetic": false, "requested_doi": "10.1609/aaai.v28i1.8870", "retrieved_at": "2026-10-01T16:48:57.743667Z", "metadata": {"doi": "10.1609/aaai.v28i1.8870", "title": "Knowledge Graph Embedding by Translating on Hyperplanes", "type": "journal-article", "authors": ["Zhen Wang", "Jianwen Zhang", "Jianlin Feng", "Zheng Chen"], "publication_year": 2014, "abstract": "<jats:p>We deal with embedding a large scale knowledge graph composed of entities and relations into a continuous vector space. TransE is a promising method proposed recently, which is very efficient while achieving state-of-the-art predictive performance. We discuss some mapping properties of relations which should be considered in embedding, such as reflexive, one-to-many, many-to-one, and many-to-many. We note that TransE does not do well in dealing with these properties. Some complex models are capable of preserving these mapping properties but sacrifice efficiency in the process. To make a good trade-off between model capacity and efficiency, in this paper we propose TransH which models a relation as a hyperplane together with a translation operation on it. In this way, we can well preserve the above mapping properties of relations with almost the same model complexity of TransE. Additionally, as a practical knowledge graph is often far from completed, how to construct negative examples to reduce false negative labels in training is very important. Utilizing the one-to-many/many-to-one mapping property of a relation, we propose a simple trick to reduce the possibility of false negative labeling. We conduct extensive experiments on link prediction, triplet classification and fact extraction on benchmark datasets like WordNet and Freebase. Experiments show TransH delivers significant improvements over TransE on predictive accuracy with comparable capability to scale up.</jats:p>", "venue": "Proceedings of the AAAI Conference on Artificial Intelligence", "publisher": "Association for the Advancement of Artificial Intelligence (AAAI)", "landing_url": "https://doi.org/10.1609/aaai.v28i1.8870", "citation_count": 2402}, "field_provenance": {"doi": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.DOI", "parser_version": "crossref-1.0.0", "availability": "present"}, "title": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.title", "parser_version": "crossref-1.0.0", "availability": "present"}, "type": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.type", "parser_version": "crossref-1.0.0", "availability": "present"}, "abstract": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.abstract", "parser_version": "crossref-1.0.0", "availability": "present"}, "publisher": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.publisher", "parser_version": "crossref-1.0.0", "availability": "present"}, "landing_url": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.URL", "parser_version": "crossref-1.0.0", "availability": "present"}, "venue": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.container-title", "parser_version": "crossref-1.0.0", "availability": "present"}, "authors": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.author", "parser_version": "crossref-1.0.0", "availability": "present"}, "publication_year": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.published.date-parts", "parser_version": "crossref-1.0.0", "availability": "present"}, "citation_count": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.is-referenced-by-count", "parser_version": "crossref-1.0.0", "availability": "present"}}, "unavailable_fields": [], "original": {"source": "openalex", "source_id": "W2283196293", "title": "Knowledge Graph Embedding by Translating on Hyperplanes", "landing_url": "https://doi.org/10.1609/aaai.v28i1.8870", "retrieved_at": "2026-10-01T03:53:06.783735Z", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "parser_version": "openalex-1.0.0", "abstract": "We deal with embedding a large scale knowledge graph composed of entities and relations into a continuous vector space. TransE is a promising method proposed recently, which is very efficient while achieving state-of-the-art predictive performance. We discuss some mapping properties of relations which should be considered in embedding, such as reflexive, one-to-many, many-to-one, and many-to-many. We note that TransE does not do well in dealing with these properties. Some complex models are capable of preserving these mapping properties but sacrifice efficiency in the process. To make a good trade-off between model capacity and efficiency, in this paper we propose TransH which models a relation as a hyperplane together with a translation operation on it. In this way, we can well preserve the above mapping properties of relations with almost the same model complexity of TransE. Additionally, as a practical knowledge graph is often far from completed, how to construct negative examples to reduce false negative labels in training is very important. Utilizing the one-to-many/many-to-one mapping property of a relation, we propose a simple trick to reduce the possibility of false negative labeling. We conduct extensive experiments on link prediction, triplet classification and fact extraction on benchmark datasets like WordNet and Freebase. Experiments show TransH delivers significant improvements over TransE on predictive accuracy with comparable capability to scale up.", "publication_year": 2014, "doi": "10.1609/aaai.v28i1.8870", "arxiv_id": null, "venue": "Proceedings of the AAAI Conference on Artificial Intelligence", "pdf_url": null, "license": null, "open_access_status": "open", "citation_count": 3849, "authors": ["Zhen Wang", "Jianwen Zhang", "Jianlin Feng", "Zheng Chen"], "authors_availability": "known", "missing_fields": ["arxiv_id", "pdf_url", "license"], "field_provenance": {"abstract": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "abstract_inverted_index"}], "authors": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "authorships[].author.display_name"}], "citation_count": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "cited_by_count"}], "doi": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "doi"}], "landing_url": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "primary_location.landing_page_url"}], "open_access_status": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "open_access.is_oa"}], "publication_year": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "publication_year"}], "source_id": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "id"}], "title": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "title"}], "venue": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "primary_location.source.display_name"}]}}, "conflicts": {"abstract": {"original_value": "We deal with embedding a large scale knowledge graph composed of entities and relations into a continuous vector space. TransE is a promising method proposed recently, which is very efficient while achieving state-of-the-art predictive performance. We discuss some mapping properties of relations which should be considered in embedding, such as reflexive, one-to-many, many-to-one, and many-to-many. We note that TransE does not do well in dealing with these properties. Some complex models are capable of preserving these mapping properties but sacrifice efficiency in the process. To make a good trade-off between model capacity and efficiency, in this paper we propose TransH which models a relation as a hyperplane together with a translation operation on it. In this way, we can well preserve the above mapping properties of relations with almost the same model complexity of TransE. Additionally, as a practical knowledge graph is often far from completed, how to construct negative examples to reduce false negative labels in training is very important. Utilizing the one-to-many/many-to-one mapping property of a relation, we propose a simple trick to reduce the possibility of false negative labeling. We conduct extensive experiments on link prediction, triplet classification and fact extraction on benchmark datasets like WordNet and Freebase. Experiments show TransH delivers significant improvements over TransE on predictive accuracy with comparable capability to scale up.", "crossref_value": "<jats:p>We deal with embedding a large scale knowledge graph composed of entities and relations into a continuous vector space. TransE is a promising method proposed recently, which is very efficient while achieving state-of-the-art predictive performance. We discuss some mapping properties of relations which should be considered in embedding, such as reflexive, one-to-many, many-to-one, and many-to-many. We note that TransE does not do well in dealing with these properties. Some complex models are capable of preserving these mapping properties but sacrifice efficiency in the process. To make a good trade-off between model capacity and efficiency, in this paper we propose TransH which models a relation as a hyperplane together with a translation operation on it. In this way, we can well preserve the above mapping properties of relations with almost the same model complexity of TransE. Additionally, as a practical knowledge graph is often far from completed, how to construct negative examples to reduce false negative labels in training is very important. Utilizing the one-to-many/many-to-one mapping property of a relation, we propose a simple trick to reduce the possibility of false negative labeling. We conduct extensive experiments on link prediction, triplet classification and fact extraction on benchmark datasets like WordNet and Freebase. Experiments show TransH delivers significant improvements over TransE on predictive accuracy with comparable capability to scale up.</jats:p>", "original_evidence": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "abstract_inverted_index"}], "crossref_evidence": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.abstract", "parser_version": "crossref-1.0.0", "availability": "present"}}, "citation_count": {"original_value": 3849, "crossref_value": 2402, "original_evidence": [{"source": "openalex", "source_id": "W2283196293", "raw_sha256": "407013ef5e071081ba5ea40c07eb50af8f9bb059a3b298bc1575cee7f7f09b37", "raw_field": "cited_by_count"}], "crossref_evidence": {"source": "crossref", "raw_path": "raw.json", "raw_sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "raw_field": "message.is-referenced-by-count", "parser_version": "crossref-1.0.0", "availability": "present"}}}}, "error": null, "request": {"attempted": true, "status_code": 200, "headers": {"x-rate-limit-limit": ["5"], "x-rate-limit-interval": ["1s"], "x-concurrency-limit": ["1"], "content-type": ["application/json"]}, "complete_body": true, "url": "https://api.crossref.org/works/10.1609%2Faaai.v28i1.8870"}, "raw": {"path": "raw.json", "sha256": "c9e951d2e7338e15d759e7e0af7ee4a2890c53cc942e2f9c4b20f9d34b589178", "byte_count": 3895}, "record_sha256": "8f9191c6a63f378bbccb5e9bc0c5b6bcf51159777083c1da3b520b42481e22b8"}
