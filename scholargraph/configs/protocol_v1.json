    },
    "map": {
      "cutoff": 100,
      "relevance_threshold": 1,
      "denominator": "all_positive_qrels",
      "trec_eval": "map_cut_100"
    },
    "precision": {
      "cutoff": 5,
      "denominator": 5,
      "trec_eval": "P_5"
    },
    "aggregation": "arithmetic_macro_over_all_frozen_split_query_ids",
    "missing_run_query": "zero_keep_in_macro",
    "no_positive_query": "zero_keep_in_macro_report_count",
    "unjudged": "zero_gain_keep_unjudged_status",
    "canonical_order": [
      "score_descending",
      "canonical_doc_id_ascending_unicode_code_points"
