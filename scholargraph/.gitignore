# Local virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]

# Testing
.pytest_cache/
.coverage

# Large datasets & raw snapshots (keep directory structure with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large artifacts & indexes
artifacts/indexes/*
!artifacts/indexes/.gitkeep
artifacts/runs/*
!artifacts/runs/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
!artifacts/reports/*.json

# Downloaded model/tokenizer cache is reproducible and too large for Git
artifacts/cache/

# Temporary pilot downloads & generated labeling kit bundle
tmp/
*.tmp
artifacts/vn_labeling_kit_SG033/
artifacts/vn_labeling_kit_SG033.zip
artifacts/vn_labeling_kit_SG033_v2/
artifacts/vn_labeling_kit_SG033_v2.zip
